<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-feature android:name="android.hardware.camera" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Kunlong_He_MyRuns2">
        
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Kunlong_He_MyRuns2">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <activity
            android:name=".UserProfileActivity"
            android:exported="false"
            android:label="MyRuns1"
            android:theme="@style/Theme.Kunlong_He_MyRuns2" />

        <activity
            android:name=".MapActivity"
            android:exported="false"
            android:label="Map"
            android:theme="@style/Theme.Kunlong_He_MyRuns2" />

        <activity
            android:name=".ManualEntryActivity"
            android:exported="false"
            android:label="Manual Entry"
            android:theme="@style/Theme.Kunlong_He_MyRuns2" />

        <activity
            android:name=".DisplayEntryActivity"
            android:exported="false"
            android:label="Entry Details"
            android:theme="@style/Theme.Kunlong_He_MyRuns2" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="moe.kunlonghe.myruns.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths">
            </meta-data>
        </provider>
            
    </application>

</manifest>